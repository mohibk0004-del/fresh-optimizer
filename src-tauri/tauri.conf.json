{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreshOptimizer",
  "version": "0.5.1",
  "identifier": "com.freshoptimizer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreshOptimizer",
        "width": 1320,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 780,
        "backgroundColor": "#0B0B0E",
        "center": true,
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://speed.cloudflare.com"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "FreshOptimizer",
    "copyright": "© 2026 FreshOptimizer",
    "shortDescription": "One-click tune-up for smoother, lower-lag games",
    "longDescription": "Anti-cheat-safe Windows latency optimizer for competitive FPS games.",
    "homepage": "https://github.com/mohibk0004-del/fresh-optimizer"
  }
}
