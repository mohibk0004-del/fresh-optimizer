{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreshOptimizer",
  "version": "0.1.0",
  "identifier": "com.freshoptimizer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreshOptimizer",
        "width": 1320,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 780,
        "backgroundColor": "#0B0B0E",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
