{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreshOptimizer Setup",
  "version": "0.5.1",
  "identifier": "com.freshoptimizer.setup",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FreshOptimizer Setup",
        "width": 760,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0B0B0E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"] }
}
